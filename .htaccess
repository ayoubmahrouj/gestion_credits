DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /gestion-credits-php/

    # URLs propres (optionnel) : /clients -> index.php?p=clients
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z_]+)/?$ index.php?p=$1 [L,QSA]
</IfModule>
